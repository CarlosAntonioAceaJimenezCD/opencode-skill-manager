#!/usr/bin/env python3
"""skillctl — gestor automático de skills para OpenCode.

Subcomandos:
  refresh                    Actualiza el índice del catálogo (llms-full.txt)
  search "<texto>"           Busca candidatas y las puntúa
  session-begin [slug...]    Inicia la sesión y fija skills para toda la sesión
  session-keep <slug...>     Suma skills al set fijo de esta sesión
  session-drop <slug...>     Quita skills del set fijo de esta sesión
  session-end                Cierra la sesión y limpia el set fijo
  begin "<tarea>"            Inicia una tarea (conserva las fijas de sesión)
  ensure <slug...>           Instala/reactiva y marca activa (sin límite)
  sync                       Desactiva lo que no sea core, fijo, activo o pinned
  sync --dry-run             Muestra qué desactivaría, sin mover nada
  status                     Muestra sesión, tarea, fijas y conteos
  list                       Lista activas y desactivadas
  enable <slug>              Reactiva una skill desactivada
  disable <slug>             Desactiva una skill (y la desfija)
  pin <slug>                 La fija para todas las sesiones
  unpin <slug>               Quita la fijación global
  restore                    Reactiva todas las desactivadas
  end                        Cierra la tarea actual (conserva las fijas)
  source add <repo...>       Registra repositorios GitHub como fuente
  source list                Lista las fuentes GitHub registradas
  source remove <repo...>    Quita fuentes GitHub
  topic add <tag...>         Registra topics de GitHub para buscar skills
  topic list                 Lista los topics registrados
  topic remove <tag...>      Quita topics registrados
  topic search [tag...]      Busca repos por topic y muestra sus skills

Fuentes GitHub:
  Acepta owner/repo, owner/repo@rama, https://github.com/owner/repo
  y URLs /tree/<rama>. Con index.json publicado usa ese catálogo; si no,
  descubre los SKILL.md del repositorio. ensure también acepta owner/repo.

Entorno:
  GITHUB_TOKEN                   Token opcional para GitHub (API y repos privados)
  OPENCODE_SKILLS_DIR            Raíz de skills a gestionar (default: dos niveles arriba del script)
  OPENCODE_SKILLS_DISABLED       Carpeta de desactivadas (default: ../skills-disabled)
  OPENCODE_SKILL_MANAGER_STATE   Archivo de estado (default: ../skill-manager/state.json)
  OPENCODE_SKILL_CATALOG_DIR     Caché del catálogo (default: ../skill-catalog)
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

def env_path(name: str, default: Path) -> Path:
    raw = os.environ.get(name, "").strip()
    return Path(raw).expanduser().resolve() if raw else default


# El script vive en <raíz-de-skills>/skill-manager/scripts/skillctl.
# parents[2] funciona igual en ~/.config/opencode/skills y en .opencode/skills.
SKILLS = env_path("OPENCODE_SKILLS_DIR", Path(__file__).resolve().parents[2])
DISABLED = env_path("OPENCODE_SKILLS_DISABLED", SKILLS.parent / "skills-disabled")
CATALOG_DIR = env_path("OPENCODE_SKILL_CATALOG_DIR", SKILLS.parent / "skill-catalog")
INDEX = CATALOG_DIR / "index.tsv"
STAMP = CATALOG_DIR / ".stamp"
STATE = env_path(
    "OPENCODE_SKILL_MANAGER_STATE", SKILLS.parent / "skill-manager" / "state.json"
)
SOURCE = "https://opencodeskills.dev/llms-full.txt"
ALLOWED_HOST = "opencodeskills.dev"
GITHUB_API = "https://api.github.com"
GITHUB_RAW = "https://raw.githubusercontent.com"
GITHUB_HOSTS = {"github.com", "www.github.com", "api.github.com", "raw.githubusercontent.com", "codeload.github.com"}
try:
    GITHUB_TOPIC_LIMIT = max(1, min(100, int(os.environ.get("GITHUB_TOPIC_LIMIT", "20"))))
except ValueError:
    GITHUB_TOPIC_LIMIT = 20
MAX_AGE = 7 * 86400
DEFAULT_CORE = ["skill-manager"]
STOPWORDS = {
    "de", "la", "el", "los", "las", "un", "una", "y", "o", "en", "con",
    "para", "por", "que", "del", "al", "se", "mi", "tu", "su", "es", "son",
    "como", "mas", "más", "pero", "sin", "sobre", "me", "te", "lo", "le",
}


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def current_session_id() -> str:
    return os.environ.get("OPENCODE_SESSION_ID", "").strip()


def ensure_session(st: dict) -> bool:
    """Si cambió la sesión de OpenCode, reinicia lo efímero y conserva lo global."""
    sid = current_session_id()
    if not sid or st.get("session_id") == sid:
        return False
    st["session_id"] = sid
    st["session_core"] = list(st.get("core", DEFAULT_CORE))
    st["active"] = []
    st["task"] = ""
    return True


def load_state() -> dict:
    st = None
    if STATE.exists():
        try:
            st = json.loads(STATE.read_text(encoding="utf-8"))
        except Exception:
            st = None
    if not isinstance(st, dict):
        st = {}
    st.setdefault("task", "")
    st.setdefault("active", [])
    st.setdefault("core", list(DEFAULT_CORE))
    st.setdefault("session_id", "")
    st.setdefault("session_core", list(st.get("core", DEFAULT_CORE)))
    st.setdefault("pinned", [])
    st.setdefault("sources", [])
    st.setdefault("topics", [])
    st.setdefault("updated", "")
    st.pop("max_active", None)
    if ensure_session(st):
        save_state(st)
    return st


def save_state(st: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    st["updated"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    STATE.write_text(
        json.dumps(st, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
    )


def github_headers(accept: str = "application/vnd.github+json") -> dict[str, str]:
    headers = {
        "User-Agent": "skillctl/1.0",
        "Accept": accept,
        "X-GitHub-Api-Version": "2022-11-28",
    }
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def download(url: str, dest: Path, headers: dict[str, str] | None = None) -> None:
    try:
        req = urllib.request.Request(url, headers=headers or {"User-Agent": "skillctl/1.0"})
        with urllib.request.urlopen(req, timeout=90) as r, open(dest, "wb") as out:
            shutil.copyfileobj(r, out)
    except Exception:
        if headers is not None:
            raise
        subprocess.run(["curl", "-fsSL", url, "-o", str(dest)], check=True)


def http_json(url: str) -> object:
    req = urllib.request.Request(url, headers=github_headers())
    with urllib.request.urlopen(req, timeout=60) as response:
        return json.loads(response.read().decode("utf-8"))


def parse_github_source(value: str) -> dict[str, str] | None:
    """Normaliza owner/repo, URL de repo o URL /tree/<rama> a un dict."""
    text = value.strip().rstrip("/")
    text = re.sub(r"^git@github\.com:", "", text, flags=re.I)
    text = re.sub(r"^https?://(?:www\.)?github\.com/", "", text, flags=re.I)
    if text.lower().startswith("github.com/"):
        text = text[len("github.com/"):]
    branch = ""
    if "@" in text:
        text, branch = text.rsplit("@", 1)
    match = re.match(r"^([^/@]+)/([^/@]+?)(?:\.git)?(?:/tree/(.+))?$", text)
    if not match:
        return None
    owner, repo = match.group(1), match.group(2)
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", owner):
        return None
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", repo):
        return None
    branch = (match.group(3) or branch or "main").strip("/")
    if not branch:
        branch = "main"
    return {
        "owner": owner,
        "repo": repo,
        "branch": branch,
        "id": f"{owner}/{repo}@{branch}",
    }


def github_zipball(src: dict[str, str]) -> str:
    owner, repo, branch = src["owner"], src["repo"], src["branch"]
    return f"{GITHUB_API}/repos/{owner}/{repo}/zipball/{urllib.parse.quote(branch, safe='/')}"


def github_raw(src: dict[str, str], path: str = "") -> str:
    owner, repo, branch = src["owner"], src["repo"], src["branch"]
    base = f"{GITHUB_RAW}/{owner}/{repo}/{urllib.parse.quote(branch, safe='/')}"
    return f"{base}/{urllib.parse.quote(path, safe='/')}" if path else base + "/"


def tagline(text: str, fallback: str) -> str:
    first = re.split(r"(?<=[.!?])\s+|\n", text.strip(), maxsplit=1)[0]
    return (first or fallback)[:120]


def yaml_field(fm: str, key: str) -> str:
    # El catálogo usa listas markdown: "- URL: https://..." o "URL: ...".
    m = re.search(rf"^(?:-\s*)?{re.escape(key)}:\s*(.*)$", fm, re.M)
    if not m:
        return ""
    val = m.group(1).strip()
    rest = fm[m.end():].splitlines()
    if val in {"|", "|-", "|+", ">", ">-", ">+"}:
        lines = []
        for line in rest:
            if line.startswith((" ", "\t")):
                lines.append(line.strip())
            elif not line.strip():
                lines.append("")
            else:
                break
        return " ".join(x for x in lines if x).strip()
    # Escalar plano que se partió en varias líneas indentadas.
    if val:
        extra = []
        for line in rest[1:] if rest and not rest[0].strip() else rest:
            if line.startswith(("  ", "\t")):
                extra.append(line.strip())
            else:
                break
        if extra:
            val = " ".join([val, *extra])
    return val.strip("\"'")


def fetch_text(url: str) -> str:
    req = urllib.request.Request(url, headers=github_headers("text/plain"))
    with urllib.request.urlopen(req, timeout=60) as response:
        return response.read().decode("utf-8", errors="replace")


def internal_path(path: str) -> bool:
    parts = Path(path).parts
    return any(
        p in {"docs", "dist", "node_modules", "__pycache__", "skills-disabled", "skill-catalog"}
        or p.startswith(".")
        for p in parts
    )


def github_catalog_rows(src: dict[str, str]) -> list[list[str]]:
    origin = f"github:{src['id']}"
    rows: list[list[str]] = []
    for prefix in ("docs/", ""):
        try:
            data = http_json(github_raw(src, prefix + "index.json"))
        except Exception:
            continue
        if not isinstance(data, dict) or not isinstance(data.get("skills"), list):
            continue
        for entry in data["skills"]:
            if not isinstance(entry, dict):
                continue
            name = str(entry.get("name", "")).strip()
            files = entry.get("files", [])
            if not name or not isinstance(files, list) or "SKILL.md" not in files:
                continue
            base = github_raw(src, prefix + name + "/")
            spec = "|".join([base, *(str(f) for f in files)])
            rows.append([
                name, name, "GitHub", f"Catálogo en {src['owner']}/{src['repo']}",
                str(entry.get("description", name)), name, f"raw-catalog|{spec}", origin,
            ])
        if rows:
            return rows
    return rows


def github_tree_rows(src: dict[str, str]) -> list[list[str]]:
    origin = f"github:{src['id']}"
    api = (
        f"{GITHUB_API}/repos/{src['owner']}/{src['repo']}/git/trees/"
        f"{urllib.parse.quote(src['branch'], safe='/')}?recursive=1"
    )
    data = http_json(api)
    if not isinstance(data, dict):
        return []
    tree = data.get("tree", [])
    paths = [
        item["path"] for item in tree
        if isinstance(item, dict) and item.get("type") == "blob"
        and item.get("path", "").endswith("SKILL.md")
    ]
    rows: list[list[str]] = []
    seen: set[str] = set()
    for path in paths:
        if internal_path(path):
            continue
        parts = Path(path).parts
        slug = parts[-2] if len(parts) >= 2 else src["repo"]
        if slug in seen:
            continue
        seen.add(slug)
        try:
            frontmatter = re.match(r"^---\n(.*?)\n---", fetch_text(github_raw(src, path)), re.S)
            fm = frontmatter.group(1) if frontmatter else ""
        except Exception:
            fm = ""
        name = yaml_field(fm, "name") or slug
        description = yaml_field(fm, "description") or f"Skill en {src['owner']}/{src['repo']}"
        rows.append([
            slug, name, "GitHub", tagline(description, name), description,
            description, github_zipball(src), origin,
        ])
    return rows


def github_rows(src: dict[str, str]) -> list[list[str]]:
    rows = github_catalog_rows(src)
    if rows:
        return rows
    return github_tree_rows(src)


def github_topic_repos(topic: str) -> list[tuple[dict[str, str], dict]]:
    """Busca repos por topic y devuelve (fuente, metadatos) con la rama real."""
    query = urllib.parse.quote(f"topic:{topic.strip()}")
    url = (
        f"{GITHUB_API}/search/repositories?q={query}"
        f"&sort=updated&per_page={GITHUB_TOPIC_LIMIT}"
    )
    data = http_json(url)
    if not isinstance(data, dict):
        return []
    results = []
    for item in data.get("items", []):
        if not isinstance(item, dict):
            continue
        src = parse_github_source(item.get("full_name", ""))
        if not src:
            continue
        branch = item.get("default_branch")
        if isinstance(branch, str) and branch:
            src["branch"] = branch
            src["id"] = f"{src['owner']}/{src['repo']}@{branch}"
        results.append((src, item))
    return results


def row_string(values: list[str]) -> str:
    return "\t".join(v.replace("\t", " ").replace("\n", " ") for v in values)


def refresh() -> None:
    CATALOG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CATALOG_DIR / "llms-full.txt.tmp"
    rows: list[str] = []
    try:
        print("descargando catálogo de opencodeskills.dev...")
        download(SOURCE, tmp)
        text = tmp.read_text(encoding="utf-8", errors="replace")
        blocks = re.split(r"(?m)^### No\. \d+ — ", text)[1:]
        for block in blocks:
            lines = block.splitlines()
            if not lines:
                continue
            name = lines[0].strip()
            body = "\n".join(lines[1:])
            url = yaml_field(body, "URL")
            if not url:
                continue
            slug = url.rstrip("/").split("/")[-1]
            vals = [
                slug, name, yaml_field(body, "Category"), yaml_field(body, "Tagline"),
                yaml_field(body, "Description"), yaml_field(body, "Triggers"),
                yaml_field(body, "Download"), "",
            ]
            rows.append(row_string(vals))
    except Exception as exc:
        print(f"aviso: no se pudo indexar opencodeskills.dev: {exc}", file=sys.stderr)
    finally:
        tmp.unlink(missing_ok=True)

    state = load_state()
    seen: set[str] = set()
    for source_id in state.get("sources", []):
        src = parse_github_source(source_id)
        if not src:
            continue
        seen.add(src["id"])
        try:
            found = github_rows(src)
            rows.extend(row_string(row) for row in found)
            print(f"{len(found)} skills en GitHub {src['owner']}/{src['repo']}")
        except Exception as exc:
            print(f"aviso: no se pudo indexar {source_id}: {exc}", file=sys.stderr)

    for topic in state.get("topics", []):
        try:
            repositories = github_topic_repos(topic)
        except Exception as exc:
            print(f"aviso: no se pudo buscar el topic {topic}: {exc}", file=sys.stderr)
            continue
        topic_skills = 0
        for src, _meta in repositories:
            if src["id"] in seen:
                continue
            seen.add(src["id"])
            try:
                found = github_rows(src)
            except Exception:
                continue
            for row in found:
                row[2] = f"GitHub:{topic}"
                rows.append(row_string(row))
            topic_skills += len(found)
        print(f"{topic_skills} skills en repos con topic {topic}")

    if not rows:
        die("no se pudo construir ningún índice")
    INDEX.write_text("\n".join(rows) + "\n", encoding="utf-8")
    STAMP.write_text(str(int(time.time())), encoding="utf-8")
    print(f"{len(rows)} skills indexadas en {INDEX}")


def ensure_index() -> None:
    if not INDEX.exists() or not STAMP.exists():
        refresh()
        return
    try:
        age = int(time.time()) - int(STAMP.read_text(encoding="utf-8").strip())
    except Exception:
        refresh()
        return
    if age > MAX_AGE:
        refresh()


def read_index() -> list[list[str]]:
    ensure_index()
    rows = []
    for line in INDEX.read_text(encoding="utf-8").splitlines():
        parts = line.split("\t")
        if len(parts) < 7:
            continue
        parts.extend([""] * (8 - len(parts)))
        rows.append(parts)
    return rows


def search(query: str) -> None:
    words = [w for w in re.split(r"\W+", query.lower()) if len(w) > 1 and w not in STOPWORDS]
    if not words:
        die('uso: skillctl search "<texto>"')
    scored = []
    for slug, name, cat, tag, desc, trig, _dl, source in read_index():
        hay = " ".join([slug, name, cat, tag, desc, trig, source]).lower()
        score = 0
        for w in words:
            if w in slug.lower():
                score += 4
            if w in name.lower():
                score += 3
            if w in trig.lower():
                score += 2
            if w in hay:
                score += 1
        if score:
            scored.append((score, slug, name, cat, tag, source))
    scored.sort(key=lambda x: (-x[0], x[1]))
    print("score\tslug\tnombre\tcategoria\ttagline\t" + "fuente")
    for score, slug, name, cat, tag, source in scored[:8]:
        print(f"{score}\t{slug}\t{name}\t{cat}\t{tag}\t{source or 'opencodeskills'}")
    if not scored:
        print("0\t-\tsin resultados\t-\t-\t-")


def find(slug: str) -> list[str] | None:
    for row in read_index():
        if row[0] == slug:
            return row
    return None


def validate_skill_dir(path: Path, slug: str) -> tuple[bool, str]:
    skill_md = path / "SKILL.md"
    if not skill_md.exists():
        return False, "falta SKILL.md"
    text = skill_md.read_text(encoding="utf-8", errors="replace")
    m = re.match(r"^---\n(.*?)\n---", text, re.S)
    if not m:
        return False, "falta frontmatter"
    fm = m.group(1)
    name = yaml_field(fm, "name")
    desc = yaml_field(fm, "description")
    if not name:
        return False, "falta name"
    if not desc:
        return False, "falta description"
    if not (1 <= len(desc) <= 1024):
        return False, f"description fuera de rango ({len(desc)} chars)"
    if name != slug:
        print(f"aviso: name={name!r} no coincide con la carpeta {slug!r}", file=sys.stderr)
    return True, "ok"


def scan_unsafe(path: Path) -> list[str]:
    pattern = re.compile(r"(curl|wget)[^\n|]*\|\s*(sh|bash)|rm\s+-rf\s+/|sudo\s+", re.I)
    bad = []
    # Los .md se excluyen: suelen citar comandos peligrosos como ejemplos de lo que prohíben.
    exts = {".sh", ".py", ".js", ".ts", ".json", ".yaml", ".yml", ".toml"}
    for p in path.rglob("*"):
        if p.is_file() and p.suffix.lower() in exts:
            try:
                if pattern.search(p.read_text(encoding="utf-8", errors="ignore")):
                    bad.append(str(p.relative_to(path)))
            except Exception:
                pass
    return bad


def safe_relative(path: str) -> bool:
    candidate = Path(path)
    return not candidate.is_absolute() and ".." not in candidate.parts


def extract_zip(zpath: Path, dest: Path, headers: dict[str, str] | None = None) -> tuple[bool, str]:
    try:
        with zipfile.ZipFile(zpath) as archive:
            for info in archive.infolist():
                name = info.filename
                if name.startswith("/") or not safe_relative(name):
                    return False, f"zip inseguro: {name}"
                mode = info.external_attr >> 16
                if mode and (mode & 0o170000) == 0o120000:
                    return False, f"zip con symlink: {name}"
            archive.extractall(dest)
    except Exception as exc:
        return False, f"zip inválido: {exc}"
    return True, "ok"


def skill_candidates(root: Path) -> list[Path]:
    found = []
    for skill_md in sorted(root.rglob("SKILL.md")):
        rel = skill_md.relative_to(root)
        if internal_path(str(rel)):
            continue
        found.append(skill_md.parent)
    return found


def normalize_candidate(src: Path, root: Path, slug: str) -> Path:
    """Un SKILL.md en la raíz del repo no debe arrastrar el zip descargado."""
    if src != root:
        return src
    target = root / f"__skill_{slug}"
    target.mkdir()
    for item in root.iterdir():
        if item != target and item.suffix != ".zip":
            shutil.move(str(item), str(target / item.name))
    return target


def commit_skill(src: Path, slug: str) -> tuple[bool, str]:
    if (SKILLS / slug).exists():
        return True, "ya instalada"
    ok, msg = validate_skill_dir(src, slug)
    if not ok:
        return False, f"validación: {msg}"
    bad = scan_unsafe(src)
    if bad:
        return False, "posibles comandos peligrosos en " + ", ".join(bad)
    SKILLS.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(SKILLS / slug))
    return True, "instalada"


def install_raw_catalog(slug: str, spec: str) -> tuple[bool, str]:
    parts = spec.split("|")
    if len(parts) < 3 or not parts[1].startswith(f"{GITHUB_RAW}/"):
        return False, "catálogo raw no permitido"
    base, files = parts[1], parts[2:]
    if "SKILL.md" not in files or any(not safe_relative(f) for f in files):
        return False, "archivos del catálogo no seguros"
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        for rel in files:
            target = root / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            try:
                download(base + rel, target, github_headers("text/plain"))
            except Exception as exc:
                return False, f"error de descarga: {exc}"
        candidates = skill_candidates(root)
        src = next((c for c in candidates if c.name == slug), None)
        if src is None:
            src = next((c for c in candidates if c.exists()), None)
        if src is None:
            return False, "el catálogo no contiene SKILL.md"
        return commit_skill(normalize_candidate(src, root, slug), slug)


def install_github_zip(slug: str, url: str) -> tuple[bool, str]:
    parsed = urllib.parse.urlparse(url)
    if parsed.hostname not in GITHUB_HOSTS:
        return False, "URL de GitHub no permitida"
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        zpath = root / "repo.zip"
        try:
            download(url, zpath, github_headers())
        except Exception as exc:
            return False, f"error de descarga: {exc}"
        ok, msg = extract_zip(zpath, root)
        if not ok:
            return False, msg
        candidates = skill_candidates(root)
        if not candidates:
            return False, "el repositorio no contiene SKILL.md"
        src = next((c for c in candidates if c.name == slug), candidates[0])
        return commit_skill(normalize_candidate(src, root, slug), slug)


def install_github_repo(value: str) -> list[tuple[str, str]]:
    src = parse_github_source(value)
    if not src:
        die(f"fuente GitHub no válida: {value}")
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        zpath = root / "repo.zip"
        try:
            download(github_zipball(src), zpath, github_headers())
        except Exception as exc:
            die(f"error de descarga de {src['id']}: {exc}")
        ok, msg = extract_zip(zpath, root)
        if not ok:
            die(msg)
        candidates = skill_candidates(root)
        if not candidates:
            die(f"{src['id']} no contiene SKILL.md")
        results = []
        for candidate in candidates:
            slug = candidate.name
            if (SKILLS / slug).exists():
                results.append((slug, "ya instalada"))
                continue
            ok, msg = commit_skill(normalize_candidate(candidate, root, slug), slug)
            results.append((slug, msg))
        return results


def install(slug: str, row: list[str] | None = None) -> tuple[bool, str]:
    if (SKILLS / slug).exists():
        return True, "ya instalada"
    if (DISABLED / slug).exists():
        SKILLS.mkdir(parents=True, exist_ok=True)
        shutil.move(str(DISABLED / slug), str(SKILLS / slug))
        return True, "reactivada"
    row = row or find(slug)
    if not row:
        return False, "no está en el catálogo"
    url = row[6]
    source = row[7] if len(row) > 7 else ""
    if url.startswith("raw-catalog|"):
        return install_raw_catalog(slug, url)
    if source.startswith("github:") or url.startswith(f"{GITHUB_API}/"):
        return install_github_zip(slug, url)
    if not url or not url.startswith(f"https://{ALLOWED_HOST}/"):
        return False, "URL de descarga no permitida"
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        zpath = root / "skill.zip"
        try:
            download(url, zpath)
        except Exception as exc:
            return False, f"error de descarga: {exc}"
        ok, msg = extract_zip(zpath, root)
        if not ok:
            return False, msg
        candidates = skill_candidates(root)
        if not candidates:
            return False, "el zip no contiene SKILL.md"
        src = next((c for c in candidates if c.name == slug), candidates[0])
        return commit_skill(normalize_candidate(src, root, slug), slug)


def cmd_ensure(slugs: list[str]) -> None:
    state = load_state()
    for slug in slugs:
        github_source = parse_github_source(slug) if "/" in slug else None
        if github_source:
            for name, msg in install_github_repo(slug):
                if name not in state["core"] and name not in state["active"]:
                    state["active"].append(name)
                print(f"{name}: {msg}; activa")
            continue
        ok, msg = install(slug)
        if not ok:
            die(f"ERROR {slug}: {msg}")
        if slug not in state["core"] and slug not in state["active"]:
            state["active"].append(slug)
        print(f"{slug}: {msg}; activa")
    save_state(state)


def cmd_sync(dry_run: bool = False) -> None:
    st = load_state()
    keep = (
        set(st.get("core", DEFAULT_CORE))
        | set(st.get("session_core", []))
        | set(st.get("active", []))
        | set(st.get("pinned", []))
    )
    DISABLED.mkdir(parents=True, exist_ok=True)
    moved, skipped = [], []
    if not SKILLS.exists():
        print("no hay skills instaladas")
        return
    for d in sorted(SKILLS.iterdir()):
        if not d.is_dir() or d.name in keep:
            continue
        if dry_run:
            moved.append(d.name)
            continue
        dest = DISABLED / d.name
        if dest.exists():
            skipped.append(d.name)
            continue
        shutil.move(str(d), str(dest))
        moved.append(d.name)
    if not dry_run:
        save_state(st)
    prefix = "(dry-run) " if dry_run else ""
    print(prefix + "activas: " + (", ".join(sorted(keep)) if keep else "ninguna"))
    print(f"{prefix}se desactivan: {len(moved)}")
    if moved:
        print(prefix + "movidas: " + ", ".join(moved))
    if skipped:
        print("aviso, ya existían en disabled: " + ", ".join(skipped))
    if not dry_run:
        print("nota: las skills ya cargadas siguen en el contexto hasta compactar.")
    extras = (set(st.get("session_core", [])) | set(st.get("pinned", []))) - set(
        st.get("core", DEFAULT_CORE)
    )
    if not st.get("active") and not extras:
        print(
            "aviso: no hay skills activas ni fijas de sesión; si esto no es intencional, "
            "usá 'skillctl restore'."
        )


def cmd_begin(task: str) -> None:
    st = load_state()
    st["task"] = task
    st["active"] = []
    save_state(st)
    print(f"tarea: {task}")
    print("activas: 0 (las fijas de sesión siguen vigentes)")


def cmd_end() -> None:
    st = load_state()
    st["task"] = ""
    st["active"] = []
    save_state(st)
    print("tarea cerrada; activas: 0 (las fijas de sesión siguen vigentes)")


def cmd_session_begin(slugs: list[str]) -> None:
    st = load_state()
    # load_state ya reinició active/task/session_core si cambió OPENCODE_SESSION_ID.
    for slug in slugs:
        ok, msg = install(slug)
        if not ok:
            die(f"ERROR {slug}: {msg}")
        if slug not in st["session_core"]:
            st["session_core"].append(slug)
        print(f"{slug}: {msg}; fija en esta sesión")
    save_state(st)
    print(f"sesión: {st.get('session_id') or '(sin id)'}")
    print("fijas: " + (", ".join(st["session_core"]) or "ninguna"))


def cmd_session_keep(slugs: list[str]) -> None:
    st = load_state()
    for slug in slugs:
        ok, msg = install(slug)
        if not ok:
            die(f"ERROR {slug}: {msg}")
        if slug not in st["session_core"]:
            st["session_core"].append(slug)
        print(f"{slug}: {msg}; fija en esta sesión")
    save_state(st)
    print("fijas: " + ", ".join(st["session_core"]))


def cmd_session_drop(slugs: list[str]) -> None:
    st = load_state()
    core = set(st.get("core", DEFAULT_CORE))
    blocked = [s for s in slugs if s in core]
    candidates = [s for s in slugs if s not in core]
    dropped = [s for s in candidates if s in st["session_core"]]
    st["session_core"] = [s for s in st["session_core"] if s not in candidates]
    save_state(st)
    if blocked:
        print("no se pueden quitar del core: " + ", ".join(blocked))
    print("quitadas de fijas: " + (", ".join(dropped) or "ninguna"))


def cmd_session_end() -> None:
    st = load_state()
    old = [s for s in st.get("session_core", []) if s not in st.get("core", DEFAULT_CORE)]
    st["session_id"] = ""
    st["session_core"] = list(st.get("core", DEFAULT_CORE))
    st["active"] = []
    st["task"] = ""
    save_state(st)
    print(f"sesión cerrada; se liberaron {len(old)} fijas de sesión")


def cmd_status() -> None:
    st = load_state()
    disk = [d.name for d in SKILLS.iterdir() if d.is_dir()] if SKILLS.exists() else []
    off = [d.name for d in DISABLED.iterdir() if d.is_dir()] if DISABLED.exists() else []
    print(f"sesión: {st.get('session_id') or '(sin id)'}")
    print(f"tarea: {st.get('task') or '(ninguna)'}")
    print(f"fijas de sesión: {', '.join(st.get('session_core', [])) or '(ninguna)'}")
    print(f"activas (estado): {', '.join(st.get('active', [])) or '(ninguna)'}")
    print(f"fijadas globales: {', '.join(st.get('pinned', [])) or '(ninguna)'}")
    print(f"fuentes GitHub: {', '.join(st.get('sources', [])) or '(ninguna)'}")
    print(f"topics GitHub: {', '.join(st.get('topics', [])) or '(ninguno)'}")
    print(f"core: {', '.join(st.get('core', DEFAULT_CORE))}")
    print(f"skills en disco: {len(disk)}")
    print(f"desactivadas: {len(off)}")
    print(f"actualizado: {st.get('updated') or '-'}")


def cmd_pin(slug: str) -> None:
    ok, msg = install(slug)
    if not ok:
        die(f"ERROR {slug}: {msg}")
    st = load_state()
    if slug not in st["pinned"]:
        st["pinned"].append(slug)
    save_state(st)
    print(f"fijada: {slug} ({msg}); no se desactiva automáticamente")


def cmd_unpin(slug: str) -> None:
    st = load_state()
    if slug not in st.get("pinned", []):
        print(f"no estaba fijada: {slug}")
        return
    st["pinned"] = [s for s in st["pinned"] if s != slug]
    save_state(st)
    print(f"desfijada: {slug}")


def cmd_source(action: str, values: list[str]) -> None:
    state = load_state()
    sources = list(state.get("sources", []))
    if action == "add":
        if not values:
            die("uso: skillctl source add <owner/repo...>")
        for value in values:
            src = parse_github_source(value)
            if not src:
                die(f"fuente GitHub no válida: {value}")
            if src["id"] not in sources:
                sources.append(src["id"])
            print(f"fuente agregada: {src['id']}")
    elif action == "remove":
        if not values:
            die("uso: skillctl source remove <owner/repo...>")
        removed = []
        for value in values:
            src = parse_github_source(value)
            target = src["id"] if src else value
            if target in sources:
                sources.remove(target)
                removed.append(target)
        print("fuentes quitadas: " + (", ".join(removed) or "ninguna"))
    elif action in {"list", ""}:
        print("fuentes GitHub: " + (", ".join(sources) or "(ninguna)"))
        return
    else:
        die("uso: skillctl source add|list|remove [owner/repo...]")
    state["sources"] = sources
    save_state(state)
    print(f"fuentes registradas: {len(sources)}")


def discover_topics(topics: list[str], register: bool = False) -> None:
    if not topics:
        die("uso: skillctl topic search <tag...>")
    state = load_state()
    printed = 0
    for topic in topics:
        try:
            repositories = github_topic_repos(topic)
        except Exception as exc:
            print(f"aviso: no se pudo buscar el topic {topic}: {exc}", file=sys.stderr)
            continue
        for src, meta in repositories:
            try:
                rows = github_rows(src)
            except Exception:
                continue
            if not rows:
                continue
            printed += 1
            slugs = ", ".join(row[0] for row in rows[:4])
            print(f"{src['owner']}/{src['repo']} [{src['branch']}]: {len(rows)} skills → {slugs}")
            print("  temas: " + (", ".join(meta.get("topics", [])[:8]) or "(ninguno)"))
            print("  " + str(meta.get("html_url", "")))
            if register and src["id"] not in state["sources"]:
                state["sources"].append(src["id"])
    if register:
        save_state(state)
        print(f"fuentes registradas: {len(state['sources'])}")
    if not printed:
        print("sin repositorios con skills para esos topics")


def cmd_topic(action: str, values: list[str]) -> None:
    state = load_state()
    topics = list(state.get("topics", []))
    if action == "add":
        if not values:
            die("uso: skillctl topic add <tag...>")
        for topic in values:
            topic = topic.strip().lstrip("#").lower()
            if not topic:
                continue
            if topic not in topics:
                topics.append(topic)
            print(f"topic registrado: {topic}")
    elif action == "remove":
        if not values:
            die("uso: skillctl topic remove <tag...>")
        targets = {v.strip().lstrip("#").lower() for v in values}
        topics = [t for t in topics if t not in targets]
        print(f"topics restantes: {len(topics)}")
    elif action in {"list", ""}:
        print("topics GitHub: " + (", ".join(topics) or "(ninguno)"))
        return
    elif action in {"search", "discover"}:
        discover_topics(values or topics)
        return
    else:
        die("uso: skillctl topic add|list|remove|search [tag...]")
    state["topics"] = topics
    save_state(state)


def cmd_list() -> None:
    print("== activas")
    if SKILLS.exists():
        for d in sorted(SKILLS.iterdir()):
            if d.is_dir():
                print(d.name)
    print("== desactivadas")
    if DISABLED.exists():
        for d in sorted(DISABLED.iterdir()):
            if d.is_dir():
                print(d.name)


def cmd_disable(slug: str) -> None:
    if slug == "skill-manager":
        die("no se puede desactivar skill-manager")
    src, dest = SKILLS / slug, DISABLED / slug
    if not src.exists():
        die(f"no existe una skill activa llamada {slug}")
    DISABLED.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        die(f"{slug} ya existe en skills-disabled")
    shutil.move(str(src), str(dest))
    st = load_state()
    st["active"] = [s for s in st.get("active", []) if s != slug]
    st["session_core"] = [s for s in st.get("session_core", []) if s != slug]
    st["pinned"] = [s for s in st.get("pinned", []) if s != slug]
    save_state(st)
    print(f"desactivada: {slug}")


def cmd_enable(slug: str) -> None:
    src, dest = DISABLED / slug, SKILLS / slug
    if dest.exists():
        print(f"ya está activa: {slug}")
        return
    if not src.exists():
        die(f"no existe una skill desactivada llamada {slug}")
    SKILLS.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dest))
    print(f"activada: {slug}")


def cmd_restore() -> None:
    if not DISABLED.exists():
        print("no hay skills desactivadas")
        return
    moved = []
    for d in sorted(DISABLED.iterdir()):
        if not d.is_dir():
            continue
        dest = SKILLS / d.name
        if dest.exists():
            continue
        shutil.move(str(d), str(dest))
        moved.append(d.name)
    print(f"reactivadas: {len(moved)}")
    if moved:
        print(", ".join(moved))


def usage() -> None:
    print(__doc__.strip())


def main() -> None:
    if len(sys.argv) < 2:
        usage()
        return
    cmd = sys.argv[1]
    args = sys.argv[2:]
    if cmd == "refresh":
        refresh()
    elif cmd == "search":
        search(" ".join(args))
    elif cmd == "begin":
        cmd_begin(" ".join(args))
    elif cmd == "ensure":
        if not args:
            die("uso: skillctl ensure <slug...>")
        cmd_ensure(args)
    elif cmd == "session-begin":
        cmd_session_begin(args)
    elif cmd == "session-keep":
        if not args:
            die("uso: skillctl session-keep <slug...>")
        cmd_session_keep(args)
    elif cmd == "session-drop":
        if not args:
            die("uso: skillctl session-drop <slug...>")
        cmd_session_drop(args)
    elif cmd == "session-end":
        cmd_session_end()
    elif cmd == "sync":
        cmd_sync("--dry-run" in args)
    elif cmd == "status":
        cmd_status()
    elif cmd == "list":
        cmd_list()
    elif cmd == "source":
        cmd_source(args[0] if args else "list", args[1:])
    elif cmd == "topic":
        cmd_topic(args[0] if args else "list", args[1:])
    elif cmd == "disable":
        if not args:
            die("uso: skillctl disable <slug>")
        cmd_disable(args[0])
    elif cmd == "enable":
        if not args:
            die("uso: skillctl enable <slug>")
        cmd_enable(args[0])
    elif cmd == "pin":
        if not args:
            die("uso: skillctl pin <slug>")
        cmd_pin(args[0])
    elif cmd == "unpin":
        if not args:
            die("uso: skillctl unpin <slug>")
        cmd_unpin(args[0])
    elif cmd == "restore":
        cmd_restore()
    elif cmd == "end":
        cmd_end()
    elif cmd in {"-h", "--help", "help"}:
        usage()
    else:
        die(f"comando desconocido: {cmd}\n\n{__doc__.strip()}")


if __name__ == "__main__":
    main()
